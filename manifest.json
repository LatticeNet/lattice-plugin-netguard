{
  "schema": "lattice.plugin.manifest.v2",
  "id": "latticenet.netguard",
  "name": "NetGuard (nftables security groups)",
  "type": "system",
  "capabilities": [
    "node:read",
    "network:plan",
    "network:apply",
    "task:run"
  ],
  "version": "0.2.0-alpha.8",
  "publisher": "latticenet",
  "signature_ed25519": "",
  "bundle": {
    "format": "tar+gzip",
    "digest_sha256": "214e92da931db668f6e07ec836383b7cf322fd415e7f5728aa1e9a79d600f97f"
  },
  "runtime": {
    "protocol": "stdio-json-v1",
    "entrypoints": {
      "linux/amd64": "bin/linux-amd64/plugin",
      "linux/arm64": "bin/linux-arm64/plugin"
    }
  },
  "ui_runtime": {
    "mode": "sandbox",
    "entrypoint": "ui/index.html",
    "bridge_version": "1"
  },
  "compatibility": {
    "server": "\u003e=0.2.2-alpha.147",
    "dashboard_host": "\u003e=1",
    "runtime_protocol": "\u003e=1"
  },
  "ui": {
    "nav": [
      {
        "section": "extensions",
        "section_title": "Extensions",
        "title": "Inbound firewall",
        "route": "firewall",
        "icon": "Shield",
        "scopes": [
          "netguard:read"
        ]
      }
    ],
    "views": [
      {
        "route": "firewall",
        "title": "Inbound firewall",
        "kind": "sandbox"
      }
    ]
  },
  "interfaces": [
    {
      "service": "latticenet.netguard/firewall",
      "methods": [
        {
          "name": "overview",
          "effect": "read",
          "scopes": [
            "netguard:read"
          ]
        },
        {
          "name": "upsert_group",
          "effect": "write",
          "scopes": [
            "netguard:admin"
          ]
        },
        {
          "name": "delete_group",
          "effect": "write",
          "scopes": [
            "netguard:admin"
          ]
        },
        {
          "name": "upsert_zone",
          "effect": "write",
          "scopes": [
            "netguard:admin"
          ]
        },
        {
          "name": "delete_zone",
          "effect": "write",
          "scopes": [
            "netguard:admin"
          ]
        },
        {
          "name": "upsert_binding",
          "effect": "write",
          "scopes": [
            "netguard:admin"
          ]
        },
        {
          "name": "adopt",
          "effect": "write",
          "scopes": [
            "netguard:admin"
          ]
        },
        {
          "name": "plan",
          "effect": "plan",
          "scopes": [
            "netguard:admin",
            "network:plan"
          ]
        },
        {
          "name": "review",
          "effect": "read",
          "scopes": [
            "netguard:read"
          ]
        },
        {
          "name": "reality",
          "effect": "read",
          "scopes": [
            "netguard:read"
          ]
        },
        {
          "name": "node_group_bindings",
          "effect": "read",
          "scopes": [
            "netguard:read",
            "group:read"
          ]
        },
        {
          "name": "upsert_node_group_binding",
          "effect": "write",
          "scopes": [
            "netguard:admin",
            "group:read"
          ]
        },
        {
          "name": "delete_node_group_binding",
          "effect": "write",
          "scopes": [
            "netguard:admin",
            "group:read"
          ]
        },
        {
          "name": "plan_node_groups",
          "effect": "plan",
          "scopes": [
            "netguard:admin",
            "network:plan",
            "group:read"
          ]
        }
      ],
      "backing": "core"
    }
  ]
}
